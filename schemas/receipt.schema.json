{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-hive.dev/schemas/receipt.schema.json",
  "title": "AgentReceipt",
  "type": "object",
  "required": ["work_id", "worker_id", "evidence", "law_root", "lease_id"],
  "properties": {
    "work_id": { "type": "string" },
    "worker_id": { "type": "string" },
    "base_artifact_root": { "type": "string" },
    "resulting_artifact_root": { "type": "string" },
    "observed_effects": { "type": "array", "items": { "type": "string" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "verifier_targets": { "type": "array", "items": { "type": "string" } },
    "law_root": { "type": "string" },
    "lease_id": { "type": "string" },
    "signature": { "type": "string" }
  },
  "additionalProperties": false
}
